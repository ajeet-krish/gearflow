{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gearflow.local/schemas/geometry.schema.json",
  "title": "GeometrySpec",
  "type": "object",
  "required": ["kind", "chord", "alphaDeg", "nPoints"],
  "properties": {
    "kind": { "enum": ["naca4", "cylinder", "block", "orifice", "custom"] },
    "naca": {
      "type": "object",
      "required": ["code", "m", "p", "t"],
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 4 },
        "m": { "type": "number", "minimum": 0, "maximum": 0.09 },
        "p": { "type": "number", "minimum": 0.2, "maximum": 0.8 },
        "t": { "type": "number", "minimum": 0.06, "maximum": 0.4 }
      }
    },
    "chord": { "type": "number" },
    "alphaDeg": { "type": "number", "minimum": -180, "maximum": 180 },
    "nPoints": { "type": "integer", "minimum": 4 },
    "radius": { "type": "number" },
    "center": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "width": { "type": "number", "description": "Block width, or orifice plate thickness (0.02 to 0.2)" },
    "height": { "type": "number", "description": "Block height, or orifice gap opening (0.05 to 1.8)" }
  }
}
