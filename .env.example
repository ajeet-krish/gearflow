# Copy to .env for local runs. Never commit real keys.
# Server only key: read by the Vite proxy middleware, never bundled (no VITE_ prefix).
META_API_KEY=
# Server only Modal proxy token for the Shared Endpoint (single combined
# proxy token in wk- and ws- Bearer format). Read by the Vite modalProxy
# middleware and the Vercel modal server handler, sent as Authorization
# Bearer, never bundled and never logged.
MODAL_PROXY_TOKEN=
# Server only Modal Shared Endpoint chat completions URL (full https URL,
# host must be a Modal serving host). Missing or hostile values fail
# closed to 503. Never commit the live URL with secrets.
MODAL_CHAT_URL=
# Server only Modal endpoint name sent as model; override on rename
# (default gearflow-chat). Never VITE_ prefixed.
MODAL_MODEL_ID=
# Kill switch for the Modal proxy. Uncomment to force the proxy to answer
# 503 disabled; the browser console lands an honest error turn.
# MODAL_DISABLED=true
# Model pins for Phase 4 Meta orchestration (standard mode only).
META_SPARK_MODEL=Llama-4-Maverick-17B-128E-Instruct
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=imagine-v1
# Demo flags consumed by the client bundle.
VITE_META_API_BASE=/api/meta
VITE_DEMO_OFFLINE=true
VITE_FLOW_SOURCE=fixture
# Public base for the Modal proxy (same origin path, never a key).
VITE_MODAL_URL=/api/modal
