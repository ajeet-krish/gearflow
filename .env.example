# Copy to .env for local runs. Never commit real keys.
# Server only key: read by the Vite proxy middleware, never bundled (no VITE_ prefix).
META_API_KEY=
# Server only Baseten key for the Muse Spark proxy. Read by the Vite
# basetenProxy middleware and injected as a Bearer token, never bundled.
BASETEN_API_KEY=
# Chat upstream selector for the shared /api/baseten proxy path (client
# untouched). Set to modal to route through the Modal Shared Endpoint;
# any other value (including unset) keeps the Baseten default for rollback.
# Server only, never VITE_ prefixed.
# CHAT_UPSTREAM=baseten
# Server only Modal Shared Endpoint chat completions URL (full https URL,
# host must be a Modal host). Used only when CHAT_UPSTREAM=modal; otherwise
# the pinned Baseten upstream is used. Never commit the live URL with secrets.
# MODAL_CHAT_URL=
# Server only Modal proxy token for the Shared Endpoint (single combined
# proxy token in wk- and ws- Bearer format). Sent as Authorization Bearer,
# never bundled and never logged. Keep BASETEN_API_KEY set for rollback.
# MODAL_PROXY_TOKEN=
# Server only Modal endpoint name sent as model for kind=modal; override on
# rename (default gearflow-chat). Never VITE_ prefixed.
# MODAL_MODEL_ID=
# Kill switch for the Baseten proxy. Uncomment to force the proxy to answer
# 503 disabled; the browser client maps that 503 to offline local mode.
# BASETEN_DISABLED=true
# Model pins for Phase 4 Meta orchestration (standard mode only).
META_SPARK_MODEL=Llama-4-Maverick-17B-128E-Instruct
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=imagine-v1
# Demo flags consumed by the client bundle.
VITE_META_API_BASE=/api/meta
VITE_DEMO_OFFLINE=true
VITE_FLOW_SOURCE=fixture
# Public base for the Baseten proxy (same origin path, never a key).
VITE_BASETEN_URL=/api/baseten
