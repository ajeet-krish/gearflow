# Copy to .env for local runs. Never commit real keys.
# Server only key: read by the Vite proxy middleware, never bundled (no VITE_ prefix).
META_API_KEY=
# Server only Baseten key for the Muse Spark proxy. Read by the Vite
# basetenProxy middleware and injected as a Bearer token, never bundled.
BASETEN_API_KEY=
# Kill switch for the Baseten proxy. Uncomment to force the proxy to answer
# 503 disabled; the browser client maps that 503 to offline local mode.
# BASETEN_DISABLED=true
# Model pins for Phase 4 Meta orchestration (standard mode only).
META_SPARK_MODEL=Llama-4-Maverick-17B-128E-Instruct
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=imagine-v1
# Demo flags consumed by the client bundle.
VITE_META_API_BASE=/api/meta
VITE_DEMO_OFFLINE=true
VITE_FLOW_SOURCE=fixture
# Public base for the Baseten proxy (same origin path, never a key).
VITE_BASETEN_URL=/api/baseten
