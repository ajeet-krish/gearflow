{
  "name": "gearflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GearFlow: solo Indie Push the Frontier flow visualizer. Phase 1 contracts and skeleton.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:fixtures": "node scripts/generate-fixtures.mjs",
    "ingest:validation": "node scripts/ingest-validation.mjs",
    "gen:dataset": "npx tsx training/gen_dataset.mjs",
    "train": "uv run --project training python training/train.py",
    "train:test": "uv run --project training pytest training/tests",
    "export": "uv run --project training python training/export_onnx.py"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "4.3.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "vitest": "2.1.3"
  }
}
